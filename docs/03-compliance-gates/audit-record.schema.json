{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novapay.example/schemas/gate-audit-record.json",
  "title": "NovaPay compliance gate audit record",
  "description": "One record per gate execution. Written to an append-only (WORM) store. Supports RBI 6.1 and PCI-DSS 10.2.",
  "type": "object",
  "required": ["schema_version", "gate", "run_id", "commit_sha", "image_digest", "environment", "actor", "result", "thresholds", "findings_summary", "regulatory_refs", "timestamp"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "gate": { "enum": ["sast", "dast", "dependency", "licence", "policy", "infra", "sod", "provenance"] },
    "run_id": { "type": "string" },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "environment": { "enum": ["dev", "staging", "pre-prod", "production"] },
    "actor": {
      "type": "object",
      "required": ["author", "approvers", "deployer"],
      "properties": {
        "author": { "type": "string" },
        "approvers": { "type": "array", "items": { "type": "string" } },
        "deployer": { "type": "string" }
      }
    },
    "result": { "enum": ["pass", "fail", "pass_with_exception"] },
    "thresholds": { "type": "object", "description": "Numeric thresholds applied, e.g. {\"critical\":0,\"high\":2}" },
    "findings_summary": {
      "type": "object",
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "report_uri": { "type": "string" }
      }
    },
    "exception_id": { "type": ["string", "null"] },
    "remediation_ticket": { "type": ["string", "null"] },
    "regulatory_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "result": { "const": "pass_with_exception" } } }, "then": { "required": ["exception_id"], "properties": { "exception_id": { "type": "string" } } } }
  ]
}
